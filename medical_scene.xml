<mujoco model="medical_scene">
  <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>

  <option timestep="0.002" gravity="0 0 -9.81">
    <flag warmstart="enable"/>
  </option>

  <visual>
    <global offwidth="1920" offheight="1080"/>
    <quality shadowsize="4096"/>
    <map force="0.1" fogstart="3" fogend="5"/>
  </visual>

  <asset>
    <texture name="floor_tex" type="2d" builtin="checker" rgb1="0.9 0.9 0.9" rgb2="0.8 0.8 0.8" width="512" height="512"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="5 5" reflectance="0.1"/>

    <texture name="metal_tex" type="2d" builtin="flat" rgb1="0.7 0.7 0.8" width="32" height="32"/>
    <material name="metal" texture="metal_tex" specular="1" shininess="0.5" reflectance="0.3"/>

    <texture name="skin_tex" type="2d" builtin="flat" rgb1="0.95 0.8 0.7" width="32" height="32"/>
    <material name="skin" texture="skin_tex" specular="0.3" shininess="0.1"/>

    <texture name="white_tex" type="2d" builtin="flat" rgb1="0.95 0.95 0.95" width="32" height="32"/>
    <material name="white" texture="white_tex" specular="0.5" shininess="0.3"/>
  </asset>

  <worldbody>
    <!-- 照明 -->
    <light directional="true" pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <light directional="true" pos="2 2 3" dir="-1 -1 -1" diffuse="0.5 0.5 0.5"/>

    <!-- 地板 -->
    <geom name="floor" type="plane" size="5 5 0.1" material="floor_mat" condim="3"/>

    <!-- 手术台 -->
    <body name="surgery_table" pos="0 0 0.5">
      <!-- 台面 -->
      <geom name="table_top" type="box" size="0.8 0.4 0.03" rgba="0.9 0.9 0.95 1" material="white"/>
      <!-- 桌腿 -->
      <geom name="table_leg1" type="cylinder" size="0.03 0.5" pos="0.7 0.3 -0.53" rgba="0.7 0.7 0.75 1"/>
      <geom name="table_leg2" type="cylinder" size="0.03 0.5" pos="0.7 -0.3 -0.53" rgba="0.7 0.7 0.75 1"/>
      <geom name="table_leg3" type="cylinder" size="0.03 0.5" pos="-0.7 0.3 -0.53" rgba="0.7 0.7 0.75 1"/>
      <geom name="table_leg4" type="cylinder" size="0.03 0.5" pos="-0.7 -0.3 -0.53" rgba="0.7 0.7 0.75 1"/>

      <!-- 患者腹部模型 -->
      <body name="patient_abdomen" pos="0 0 0.1">
        <geom name="abdomen" type="ellipsoid" size="0.15 0.2 0.08" material="skin"/>
        <!-- 手术切口区域 -->
        <geom name="surgical_site" type="box" size="0.08 0.06 0.01" pos="0 0.05 0.08" rgba="0.9 0.6 0.6 1"/>
      </body>
    </body>

    <!-- 医疗机械臂（手术机器人） -->
    <body name="robot_base" pos="1.2 0 0">
      <geom name="base" type="cylinder" size="0.1 0.05" rgba="0.3 0.3 0.4 1" material="metal"/>

      <!-- 第一关节（底座旋转） -->
      <body name="link1" pos="0 0 0.05">
        <joint name="joint1" type="hinge" axis="0 0 1" range="-180 180" damping="0.5"/>
        <geom name="link1_geom" type="cylinder" size="0.04 0.3" rgba="0.4 0.4 0.5 1" material="metal"/>

        <!-- 第二关节（肩部） -->
        <body name="link2" pos="0 0 0.3">
          <joint name="joint2" type="hinge" axis="0 1 0" range="-120 120" damping="0.5"/>
          <geom name="link2_geom" type="capsule" fromto="0 0 0 0 0 0.25" size="0.03" rgba="0.5 0.5 0.6 1" material="metal"/>

          <!-- 第三关节（肘部） -->
          <body name="link3" pos="0 0 0.25">
            <joint name="joint3" type="hinge" axis="0 1 0" range="-140 140" damping="0.3"/>
            <geom name="link3_geom" type="capsule" fromto="0 0 0 0 0 0.2" size="0.025" rgba="0.6 0.6 0.7 1" material="metal"/>

            <!-- 腕部关节 -->
            <body name="wrist" pos="0 0 0.2">
              <joint name="joint4" type="hinge" axis="0 0 1" range="-180 180" damping="0.2"/>
              <geom name="wrist_geom" type="cylinder" size="0.02 0.03" rgba="0.7 0.7 0.8 1" material="metal"/>

              <!-- 末端执行器（手术钳） -->
              <body name="gripper_base" pos="0 0 0.03">
                <geom name="gripper_palm" type="box" size="0.015 0.02 0.04" rgba="0.8 0.8 0.9 1" material="metal"/>

                <!-- 左侧钳口 -->
                <body name="left_finger" pos="0 0.02 0.03">
                  <joint name="left_finger_joint" type="hinge" axis="1 0 0" range="0 30" damping="0.1"/>
                  <geom name="left_finger_geom" type="box" size="0.01 0.005 0.03" rgba="0.9 0.9 1 1" material="metal"/>
                </body>

                <!-- 右侧钳口 -->
                <body name="right_finger" pos="0 -0.02 0.03">
                  <joint name="right_finger_joint" type="hinge" axis="1 0 0" range="-30 0" damping="0.1"/>
                  <geom name="right_finger_geom" type="box" size="0.01 0.005 0.03" rgba="0.9 0.9 1 1" material="metal"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- 手术器械托盘 -->
    <body name="instrument_tray" pos="-0.8 0.6 0.8">
      <geom name="tray" type="box" size="0.15 0.2 0.02" rgba="0.85 0.85 0.9 1" material="metal"/>

      <!-- 手术刀 -->
      <body name="scalpel" pos="-0.08 0 0.03">
        <freejoint/>
        <geom name="scalpel_handle" type="capsule" fromto="0 0 0 0 0 0.08" size="0.005" rgba="0.3 0.3 0.3 1"/>
        <geom name="scalpel_blade" type="box" size="0.002 0.008 0.015" pos="0 0 0.09" rgba="0.9 0.9 0.95 1" material="metal"/>
      </body>

      <!-- 镊子 -->
      <body name="forceps" pos="0 0 0.03">
        <freejoint/>
        <geom name="forceps_body" type="capsule" fromto="0 0 0 0 0 0.1" size="0.004" rgba="0.8 0.8 0.85 1" material="metal"/>
        <geom name="forceps_tip1" type="box" size="0.002 0.004 0.015" pos="-0.003 0 0.105" rgba="0.85 0.85 0.9 1" material="metal"/>
        <geom name="forceps_tip2" type="box" size="0.002 0.004 0.015" pos="0.003 0 0.105" rgba="0.85 0.85 0.9 1" material="metal"/>
      </body>

      <!-- 注射器 -->
      <body name="syringe" pos="0.08 0 0.03">
        <freejoint/>
        <geom name="syringe_barrel" type="cylinder" size="0.006 0.05" rgba="0.9 0.9 0.95 0.7"/>
        <geom name="syringe_plunger" type="capsule" fromto="0 0 0.05 0 0 0.08" size="0.003" rgba="0.8 0.8 0.85 1"/>
        <geom name="syringe_needle" type="capsule" fromto="0 0 -0.05 0 0 -0.07" size="0.001" rgba="0.9 0.9 0.95 1" material="metal"/>
      </body>
    </body>

    <!-- 监护仪支架 -->
    <body name="monitor_stand" pos="0.5 1 0">
      <geom name="stand_pole" type="cylinder" size="0.02 0.8" rgba="0.4 0.4 0.45 1" material="metal"/>
      <!-- 监护仪屏幕 -->
      <body name="monitor" pos="0 0 0.8">
        <geom name="monitor_screen" type="box" size="0.15 0.02 0.12" rgba="0.1 0.1 0.15 1"/>
        <geom name="monitor_display" type="box" size="0.14 0.015 0.11" pos="0 -0.021 0" rgba="0.2 0.3 0.25 1"/>
      </body>
    </body>

  </worldbody>

  <actuator>
    <!-- 机械臂执行器 -->
    <motor name="motor1" joint="joint1" ctrlrange="-2 2" ctrllimited="true"/>
    <motor name="motor2" joint="joint2" ctrlrange="-2 2" ctrllimited="true"/>
    <motor name="motor3" joint="joint3" ctrlrange="-2 2" ctrllimited="true"/>
    <motor name="motor4" joint="joint4" ctrlrange="-1 1" ctrllimited="true"/>
    <motor name="motor_left_finger" joint="left_finger_joint" ctrlrange="-0.5 0.5" ctrllimited="true"/>
    <motor name="motor_right_finger" joint="right_finger_joint" ctrlrange="-0.5 0.5" ctrllimited="true"/>
  </actuator>

</mujoco>
